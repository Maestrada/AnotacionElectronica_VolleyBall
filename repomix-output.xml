    Task<AlineacionDetalleDto> RegistrarEntradaLiberoAsync(ReemplazoLiberoDto dto);
    Task<AlineacionDetalleDto> RegistrarSalidaLiberoAsync(Guid setId, Guid equipoId, PosicionCancha posicion);
