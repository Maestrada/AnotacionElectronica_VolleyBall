<file path="src/AnotacionElectronica_Leon_VB.Application/Services/PartidoService.cs">
using AnotacionElectronica_Leon_VB.Application.DTOs;
using AnotacionElectronica_Leon_VB.Application.Interfaces;
using AnotacionElectronica_Leon_VB.Domain.Entities;
using AnotacionElectronica_Leon_VB.Domain.Enums;

namespace AnotacionElectronica_Leon_VB.Application.Services;

public class PartidoService : IPartidoService
{
    private readonly IPartidoRepository _partidoRepository;

    public PartidoService(IPartidoRepository partidoRepository)
    {
        _partidoRepository = partidoRepository;
    }

    #region Gestión de Partido

    public async Task<PartidoResponseDto> CrearPartidoAsync(CrearPartidoDto dto)
    {
        var partido = new Partido(
            dto.EquipoLocalId,
            dto.EquipoVisitanteId,
            dto.FechaProgramada,
            dto.Sede,
            dto.Rama,
            dto.Categoria
        );

        await _partidoRepository.CrearPartidoAsync(partido);
        await _partidoRepository.SaveChangesAsync();

        return MapearPartidoADto(partido);
    }

    public async Task<PartidoResponseDto?> GetPartidoByIdAsync(Guid partidoId)
    {
        var partido = await _partidoRepository.GetPartidoConDetallesAsync(partidoId);
        return partido is null ? null : MapearPartidoADto(partido);
    }

    public async Task IniciarPartidoAsync(Guid partidoId)
    {
        var partido = await _partidoRepository.GetPartidoConDetallesAsync(partidoId)
            ?? throw new KeyNotFoundException($"No se encontró el partido con ID {partidoId}");

        if (partido.Sets.Count == 0)
        {
            var primerSet = new Set(partido.Id, 1);
            partido.Sets.Add(primerSet);
        }

        await _partidoRepository.SaveChangesAsync();
    }

    public async Task FinalizarPartidoAsync(Guid partidoId)
    {
        var partido = await _partidoRepository.GetPartidoConDetallesAsync(partidoId)
            ?? throw new KeyNotFoundException($"No se encontró el partido con ID {partidoId}");

        partido.Finalizado = true;
        await _partidoRepository.SaveChangesAsync();
    }

    public async Task<PartidoResumenDto> ObtenerResumenPartidoAsync(Guid partidoId)
    {
        var partido = await _partidoRepository.GetPartidoConDetallesAsync(partidoId)
            ?? throw new KeyNotFoundException($"No se encontró el partido con ID {partidoId}");

        var setsDto = partido.Sets.Select(s => new SetDetalleDto(
            s.Id, s.PartidoId, s.NumeroSet, s.PuntosLocal, s.PuntosVisitante, s.Finalizado, s.EquipoGanadorId
        ));

        return new PartidoResumenDto(
            partido.Id,
            partido.EquipoLocalId,
            partido.EquipoVisitanteId,
            partido.SetsGanadosLocal,
            partido.SetsGanadosVisitante,
            partido.Finalizado,
            partido.EquipoGanadorId,
            setsDto
        );
    }

    #endregion

    #region Control de Sets

    public async Task<SetDetalleDto> IniciarSetAsync(Guid partidoId, int numeroSet)
    {
        var partido = await _partidoRepository.GetPartidoConDetallesAsync(partidoId)
            ?? throw new KeyNotFoundException($"No se encontró el partido con ID {partidoId}");

        var nuevoSet = new Set(partidoId, numeroSet);
        partido.Sets.Add(nuevoSet);

        await _partidoRepository.SaveChangesAsync();

        return new SetDetalleDto(nuevoSet.Id, nuevoSet.PartidoId, nuevoSet.NumeroSet, nuevoSet.PuntosLocal, nuevoSet.PuntosVisitante, nuevoSet.Finalizado, nuevoSet.EquipoGanadorId);
    }

    public async Task<SetDetalleDto> FinalizarSetAsync(Guid setId)
    {
        var set = await _partidoRepository.GetSetPorIdAsync(setId)
            ?? throw new KeyNotFoundException($"No se encontró el set con ID {setId}");

        set.Finalizado = true;
        await _partidoRepository.SaveChangesAsync();

        return new SetDetalleDto(set.Id, set.PartidoId, set.NumeroSet, set.PuntosLocal, set.PuntosVisitante, set.Finalizado, set.EquipoGanadorId);
    }

    public async Task<SetDetalleDto?> ObtenerSetActualAsync(Guid partidoId)
    {
        var partido = await _partidoRepository.GetPartidoConDetallesAsync(partidoId);
        if (partido is null) return null;

        var setActual = partido.Sets.OrderByDescending(s => s.NumeroSet).FirstOrDefault();
        if (setActual is null) return null;

        return new SetDetalleDto(setActual.Id, setActual.PartidoId, setActual.NumeroSet, setActual.PuntosLocal, setActual.PuntosVisitante, setActual.Finalizado, setActual.EquipoGanadorId);
    }

    #endregion

    #region Control de Puntos y Marcador

    public async Task<MarcadorLiveDto> RegistrarPuntoAsync(RegistrarPuntoDto dto)
    {
        var partido = await _partidoRepository.GetPartidoConDetallesAsync(dto.PartidoId)
            ?? throw new KeyNotFoundException($"No se encontró el partido con ID {dto.PartidoId}");

        var setActual = partido.Sets
            .OrderByDescending(s => s.NumeroSet)
            .FirstOrDefault() ?? throw new InvalidOperationException("No hay un set activo para registrar puntos.");

        if (setActual.Finalizado)
            throw new InvalidOperationException("El set actual ya ha finalizado.");

        if (dto.EquipoAnotadorId == partido.EquipoLocalId)
        {
            setActual.PuntosLocal++;
        }
        else if (dto.EquipoAnotadorId == partido.EquipoVisitanteId)
        {
            setActual.PuntosVisitante++;
        }
        else
        {
            throw new ArgumentException("El equipo anotador no pertenece a este partido.");
        }

        bool huboRecuperacionDeSaque = setActual.UltimoEquipoAlSaqueId.HasValue &&
                                       setActual.UltimoEquipoAlSaqueId.Value != dto.EquipoAnotadorId;

        if (huboRecuperacionDeSaque)
        {
            var alineacionAnotador = await _partidoRepository.GetAlineacionPorSetYEquipoAsync(setActual.Id, dto.EquipoAnotadorId);
            alineacionAnotador?.RotarSentidoHorario();
        }

        setActual.UltimoEquipoAlSaqueId = dto.EquipoAnotadorId;

        var punto = new Punto(
            setActual.Id,
            dto.EquipoAnotadorId,
            setActual.PuntosLocal,
            setActual.PuntosVisitante,
            dto.TipoPunto,
            dto.JugadorAnotadorId
        );
        await _partidoRepository.GuardarPuntoAsync(punto);

        VerificarCierreDeSet(partido, setActual);
        await _partidoRepository.SaveChangesAsync();

        return new MarcadorLiveDto(
            setActual.Id,
            setActual.PuntosLocal,
            setActual.PuntosVisitante,
            setActual.UltimoEquipoAlSaqueId,
            setActual.Finalizado,
            partido.Finalizado
        );
    }

    public async Task<MarcadorLiveDto> DeshacerUltimaAccionAsync(Guid setId)
    {
        var set = await _partidoRepository.GetSetPorIdAsync(setId)
            ?? throw new KeyNotFoundException($"No se encontró el set con ID {setId}");

        // Lógica de reversión delegada al repositorio o dominio
        await _partidoRepository.DeshacerUltimoPuntoAsync(setId);
        await _partidoRepository.SaveChangesAsync();

        return new MarcadorLiveDto(set.Id, set.PuntosLocal, set.PuntosVisitante, set.UltimoEquipoAlSaqueId, set.Finalizado, false);
    }

    #endregion

    #region Alineaciones, Sustituciones y Líbero

    public async Task<AlineacionDetalleDto> RegistrarAlineacionInicialAsync(RegistrarAlineacionInicialDto dto)
    {
        var ids = new[]
        {
            dto.JugadorPosicion1Id, dto.JugadorPosicion2Id, dto.JugadorPosicion3Id,
            dto.JugadorPosicion4Id, dto.JugadorPosicion5Id, dto.JugadorPosicion6Id
        };

        if (ids.Distinct().Count() != 6)
            throw new InvalidOperationException("La alineación inicial debe contener 6 jugadores distintos.");

        var alineacionExistente = await _partidoRepository.GetAlineacionPorSetYEquipoAsync(dto.SetId, dto.EquipoId);
        if (alineacionExistente is not null)
            throw new InvalidOperationException("La alineación inicial para este equipo en este set ya fue registrada.");

        var alineacion = new AlineacionSet(
            dto.SetId,
            dto.EquipoId,
            dto.JugadorPosicion1Id,
            dto.JugadorPosicion2Id,
            dto.JugadorPosicion3Id,
            dto.JugadorPosicion4Id,
            dto.JugadorPosicion5Id,
            dto.JugadorPosicion6Id
        );

        await _partidoRepository.GuardarAlineacionAsync(alineacion);
        await _partidoRepository.SaveChangesAsync();

        return MapearAlineacionADto(alineacion);
    }

    public async Task<AlineacionDetalleDto> RegistrarSustitucionAsync(RegistrarSustitucionDto dto)
    {
        var alineacion = await _partidoRepository.GetAlineacionPorSetYEquipoAsync(dto.SetId, dto.EquipoId)
            ?? throw new KeyNotFoundException("No se encontró la alineación activa para este equipo en el set.");

        var set = await _partidoRepository.GetSetPorIdAsync(dto.SetId);
        if (set is null || set.Finalizado)
            throw new InvalidOperationException("El set no existe o ya está finalizado.");

        alineacion.RealizarSustitucionReglamentaria(
            dto.JugadorSaleId,
            dto.JugadorEntraId,
            set.PuntosLocal,
            set.PuntosVisitante
        );

        await _partidoRepository.SaveChangesAsync();
        return MapearAlineacionADto(alineacion);
    }

    public async Task<AlineacionDetalleDto> RegistrarEntradaLiberoAsync(ReemplazoLiberoDto dto)
    {
        var alineacion = await _partidoRepository.GetAlineacionPorSetYEquipoAsync(dto.SetId, dto.EquipoId)
            ?? throw new KeyNotFoundException("No se encontró la alineación del set para este equipo.");

        alineacion.EntrarLibero(dto.LiberoId, dto.Posicion);
        await _partidoRepository.SaveChangesAsync();

        return MapearAlineacionADto(alineacion);
    }

    public async Task<AlineacionDetalleDto> RegistrarSalidaLiberoAsync(Guid setId, Guid equipoId, PosicionCancha posicion)
    {
        var alineacion = await _partidoRepository.GetAlineacionPorSetYEquipoAsync(setId, equipoId)
            ?? throw new KeyNotFoundException("No se encontró la alineación del set para este equipo.");

        alineacion.SalirLibero(posicion);
        await _partidoRepository.SaveChangesAsync();

        return MapearAlineacionADto(alineacion);
    }

    public async Task<AlineacionDetalleDto?> ObtenerAlineacionSetAsync(Guid setId, Guid equipoId)
    {
        var alineacion = await _partidoRepository.GetAlineacionPorSetYEquipoAsync(setId, equipoId);
        return alineacion is null ? null : MapearAlineacionADto(alineacion);
    }

    public async Task<RotacionActualDto> ObtenerRotacionActualAsync(Guid setId, Guid equipoId)
    {
        var alineacion = await _partidoRepository.GetAlineacionPorSetYEquipoAsync(setId, equipoId)
            ?? throw new KeyNotFoundException("No se encontró la alineación para el set y equipo especificados.");

        return new RotacionActualDto(
            alineacion.SetId,
            alineacion.EquipoId,
            alineacion.PosicionesActuales,
            alineacion.ObtenerJugadorAlSaque()
        );
    }

    #endregion

    #region Tiempos de Descanso

    public async Task<TiempoDescansoDetalleDto> SolicitarTiempoDescansoAsync(SolicitarTiempoDescansoDto dto)
    {
        var set = await _partidoRepository.GetSetPorIdAsync(dto.SetId)
            ?? throw new KeyNotFoundException($"No se encontró el set con ID {dto.SetId}");

        var tiempo = new TiempoDescanso(dto.SetId, dto.EquipoId, set.PuntosLocal, set.PuntosVisitante);
        await _partidoRepository.GuardarTiempoDescansoAsync(tiempo);
        await _partidoRepository.SaveChangesAsync();

        int tiemposUsados = await _partidoRepository.ContarTiemposDescansoEquipoAsync(dto.SetId, dto.EquipoId);

        return new TiempoDescansoDetalleDto(
            tiempo.Id,
            tiempo.SetId,
            tiempo.EquipoId,
            tiempo.PuntosLocal,
            tiempo.PuntosVisitante,
            Math.Max(0, 2 - tiemposUsados)
        );
    }

    public async Task<int> ObtenerTiemposRestantesEquipoAsync(Guid setId, Guid equipoId)
    {
        int usados = await _partidoRepository.ContarTiemposDescansoEquipoAsync(setId, equipoId);
        return Math.Max(0, 2 - usados);
    }

    #endregion

    #region Sanciones Disciplinarias

    public async Task RegistrarSancionAsync(RegistrarSancionDto dto)
    {
        var sancion = new Sancion(dto.PartidoId, dto.EquipoId, dto.JugadorId, dto.TipoSancion, dto.Motivo);
        await _partidoRepository.GuardarSancionAsync(sancion);
        await _partidoRepository.SaveChangesAsync();
    }

    public async Task<IEnumerable<SancionDetalleDto>> ObtenerSancionesPartidoAsync(Guid partidoId)
    {
        var sanciones = await _partidoRepository.ObtenerSancionesPorPartidoAsync(partidoId);
        return sanciones.Select(s => new SancionDetalleDto(
            s.Id, s.PartidoId, s.EquipoId, s.JugadorId, s.TipoSancion, s.Motivo, s.FechaHora
        ));
    }

    #endregion

    #region Métodos Privados Auxiliares

    private static void VerificarCierreDeSet(Partido partido, Set set)
    {
        int puntosMinimos = (set.NumeroSet == 5) ? 15 : 25;
        int maxPuntos = Math.Max(set.PuntosLocal, set.PuntosVisitante);
        int diferencia = Math.Abs(set.PuntosLocal - set.PuntosVisitante);

        if (maxPuntos >= puntosMinimos && diferencia >= 2)
        {
            set.Finalizado = true;
            if (set.PuntosLocal > set.PuntosVisitante)
            {
                set.EquipoGanadorId = partido.EquipoLocalId;
                partido.SetsGanadosLocal++;
            }
            else
            {
                set.EquipoGanadorId = partido.EquipoVisitanteId;
                partido.SetsGanadosVisitante++;
            }

            if (partido.SetsGanadosLocal == 3 || partido.SetsGanadosVisitante == 3)
            {
                partido.Finalizado = true;
                partido.EquipoGanadorId = partido.SetsGanadosLocal == 3
                    ? partido.EquipoLocalId
                    : partido.EquipoVisitanteId;
            }
        }
    }

    private static AlineacionDetalleDto MapearAlineacionADto(AlineacionSet a)
    {
        return new AlineacionDetalleDto(
            a.Id,
            a.SetId,
            a.EquipoId,
            a.SustitucionesRealizadas,
            a.PosicionesActuales,
            a.ObtenerJugadorAlSaque()
        );
    }

    private static PartidoResponseDto MapearPartidoADto(Partido p)
    {
        return new PartidoResponseDto(
            p.Id,
            p.EquipoLocalId,
            p.EquipoVisitanteId,
            p.FechaProgramada,
            p.Sede,
            p.SetsGanadosLocal,
            p.SetsGanadosVisitante,
            p.Finalizado,
            p.EquipoGanadorId
        );
    }

    #endregion
}
