    {
        if (_jugadores.Any(j => j.NumeroCamiseta == jugador.NumeroCamiseta))
            throw new InvalidOperationException($"Ya existe un jugador con la camiseta #{jugador.NumeroCamiseta} en este equipo.");

        _jugadores.Add(jugador);
    }
}
